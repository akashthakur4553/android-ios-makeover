<?xml version="1.0" encoding="utf-8"?>
<!-- Dynamic Island, status-bar gestures and the app switcher. Never reads text/content of other apps;
     it only notes which app is in front and keeps a small in-memory snapshot for the switcher cards. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:canTakeScreenshot="true"
    android:canRequestFilterKeyEvents="true"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:notificationTimeout="0"
    android:description="@string/island_desc"
    android:settingsActivity="com.glass.launcher.SettingsActivity" />
